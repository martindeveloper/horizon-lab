# Optional overrides for src/config.ts. Unset or blank values fall back to production.
# NEXT_PUBLIC_ values are inlined at build time: rebuild or restart `npm run dev` after a change.

# Public origin for canonical URLs, robots and the sitemap (Vercel's production domain wins over the fallback).
# SITE_URL=https://horizon.martinpernica.xyz

# CDN for the music and the orrery's maps; it must send CORS headers.
# NEXT_PUBLIC_CDN_URL=https://cdn.horizonlab.observer

# Source code link in the footer and on the about page.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/martindeveloper/horizon-lab

# Vercel Web Analytics and Speed Insights; set to off (or false, 0) to leave them out.
# ANALYTICS=on

# Deployment ID behind the "new version" notice; Vercel's VERCEL_DEPLOYMENT_ID by default, off when blank.
# NEXT_PUBLIC_DEPLOYMENT_ID=local-1

# Horizon.Debug console tools: on in `npm run dev` and Vercel previews, off in production.
# NEXT_PUBLIC_DEBUG=on

# Feature switches (FEATURES in src/config.ts): on in `npm run dev` with the debug tools on, off
# in previews, production and `npm run build`, unless released (on everywhere); set one to on
# (or off) to decide for a build.
# NEXT_PUBLIC_FEATURE_VOYAGE=on
# NEXT_PUBLIC_FEATURE_GIANTS=off
# NEXT_PUBLIC_FEATURE_SUN=on

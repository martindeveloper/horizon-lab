// Mathematical constants for every shader. Guarded, because three.js's
// <common> chunk defines PI too; the values are the float64 constants.
#ifndef PI
#define PI 3.141592653589793
#endif
#ifndef TWO_PI
#define TWO_PI 6.283185307179586
#endif
#ifndef HALF_PI
#define HALF_PI 1.5707963267948966
#endif
